rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: viveres
    // Document ID: User UID
    // Fields:
    //   - ownerId: string (required) - The UID of the restaurant owner
    //   - nombre: string (required) - Name of the restaurant
    //   - estado: string (required) - Status: 'pendiente', 'verificado', 'rechazado'
    //   - status: string (optional) - Alias for estado
    //   - email: string (required) - Contact email
    //   - telefono: string (required) - Contact phone
    //   - direccion: string (required) - Physical address
    //   - location: geopoint (required) - Coordinates
    //   - rfc: string (required) - Tax ID
    //   - ineFrontUrl: string (required) - URL to INE front image
    //   - ineBackUrl: string (required) - URL to INE back image
    //   - selfieUrl: string (required) - URL to verification selfie
    //   - createdAt: timestamp (required) - Creation date
    //   - rating: number (optional) - Average rating
    //   - isOpen: boolean (optional) - Current status
    //
    // Collection: products
    // Fields: restaurantId, name, description, price, category, available, imageUrl
    //
    // Collection: orders
    // Fields: customerId, restaurantId, status, items, total, createdAt
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "2430936@upt.edu.mx";
    }

    function isRestaurantOwner(restaurantId) {
      return isAuthenticated() && (
        request.auth.uid == restaurantId ||
        (exists(/databases/$(database)/documents/viveres/$(restaurantId)) &&
         get(/databases/$(database)/documents/viveres/$(restaurantId)).data.ownerId == request.auth.uid)
      );
    }

    function isValidViveres(data) {
      return data.keys().hasAll(['ownerId', 'nombre', 'estado', 'email', 'telefono', 'direccion', 'location', 'rfc', 'ineFrontUrl', 'ineBackUrl', 'selfieUrl']) &&
             data.ownerId is string &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 100 &&
             data.estado in ['pendiente', 'verificado', 'rechazado'] &&
             (!('status' in data) || data.status in ['pendiente', 'verificado', 'rechazado']) &&
             data.email is string &&
             data.telefono is string &&
             data.direccion is string &&
             data.rfc is string;
    }

    // ===============================================================
    // Collections
    // ===============================================================

    match /viveres/{restaurantId} {
      // Allow authenticated users to read restaurant info
      allow read: if isAuthenticated();
      
      // Only admins can create/delete in viveres directly
      // Or if the user IS the restaurant (self-create for onboarding)
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == restaurantId);
      allow delete: if isAdmin();
      
      // Allow owners to update their info, but NOT the status (estado) unless admin
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == restaurantId && 
         request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.estado == resource.data.estado)
      );
    }

    match /solicitudes_de_registro/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (isAdmin() || (resource.data.userId == request.auth.uid));

      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid;
      
      allow update, delete: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true; // Public can see promos
      allow list: if true;
      allow create, update, delete: if isAuthenticated() && (
        isAdmin() || 
        isRestaurantOwner(request.resource.data.storeId || resource.data.storeId)
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && (
        isAdmin() ||
        isRestaurantOwner(request.resource.data.restaurantId || resource.data.restaurantId)
      );
    }

    match /_connection_test_/{docId} {
      allow read: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.customerId || 
        isRestaurantOwner(resource.data.restaurantId)
      );
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isRestaurantOwner(resource.data.restaurantId) || 
        (request.auth.uid == resource.data.customerId && request.resource.data.status == 'cancelled')
      );
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
